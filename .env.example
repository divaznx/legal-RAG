# Copy to .env and adjust.

# Vector DB — embedded on-disk Qdrant by default; set QDRANT_URL for a server.
QDRANT_PATH=./data/qdrant
#QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=lexis_chunks_v2

# Embeddings (fastembed / ONNX — no torch needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# Reranking (cross-encoder second stage — orders candidates only)
USE_RERANKER=true
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Refusal gate: dense cosine of best candidate (calibrated relevance signal)
MIN_DENSE_SCORE=0.5

# LLM — any OpenAI-compatible endpoint; defaults to local Ollama.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3:8b
OLLAMA_API_KEY=ollama
LLM_MAX_TOKENS=700
LLM_KEEP_ALIVE=30m

# Chunking / retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
CANDIDATE_K=20
FINAL_K=4

# Semantic answer cache
CACHE_ENABLED=true
CACHE_SIMILARITY=0.95
CACHE_MAX_ENTRIES=200
